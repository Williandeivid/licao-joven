# Backups locais do index.html - nao devem ir para o repositorio
index.html.backup*
index.html.pre-*
*.backup
*.backup[0-9]

# Saidas temporarias
*.log
.DS_Store
Thumbs.db

# Capacitor (apps Android/iOS) - node_modules e www/ sao gerados;
# rode `npm run build:www` (ou `npm run cap:sync`) pra recriar www/.
# android/ e ios/ SAO versionados (tem config nativa editada nas IDEs),
# cada um com seu proprio .gitignore pros artefatos de build deles.
node_modules/
www/

# Credenciais do Firebase por plataforma (login nativo) - nunca versionar
android/app/google-services.json
ios/App/App/GoogleService-Info.plist
