  "dias": [
    {"id": "dom", "letra": "D", "data": "Domingo · 14 de setembro", "titulo": "A Morte de Cristo", "keyideas": "Finitude genuína · Corpo inerte · Esperança silenciosa · Repouso antes de vitória", "verses": ["Mateus 27:57-60", "Marcos 15:42-46", "Lucas 23:50-53"], "conteudo": "<b>\"E quando veio a noite, veio um homem rico...\"</b> José de Arimateia <b>buscava o corpo — não para reverência vã, mas para honra genuína</b>. <b>Mesmo morte era tratada com dignidade</b>.\n\n<b>O sepultamento confirmava morte genuína.</b> <b>Não era fantasia, não era trance — era corpo realmente falecido, realmente enterrado</b>. <b>Esperança não era em fuga da morte, mas através dela</b>.\n\n<b>\"No sepulcro novo de José...\"</b> Localização específica, testemunhas confirmadas. <b>Três dias de escuridão completa aguardava</b> — mas <b>na profundidade deste silêncio, maior esperança se germinavava</b>.", "reflexivas": ["Por que sepultamento importava?", "Como morte era honrada?", "Por que silêncio era fecundo?"], "quiz": [{"dif": "Fácil", "q": "Quem buscava o corpo?", "op": ["A) Pilatos", "B) Discípulos", "C) José de Arimateia", "D) Soldados"]},"r": "C"},{"dif": "Fácil", "q": "O corpo era real?", "op": ["A) Não", "B) Sim — genuinamente falecido", "C) Talvez", "D) Aparente"]},"r": "B"},{"dif": "Fácil", "q": "Havia esperança?", "op": ["A) Não", "B) Sim — silenciosa", "C) Impossível", "D) Irrelevante"]},"r": "B"},{"dif": "Intermediária", "q": "Por que localização importava?", "op": ["A) Sem razão", "B) Testemunhas confirmavam", "C) Era irrelevante", "D) Ficção"]},"r": "B"},{"dif": "Intermediária", "q": "Como morte era honrada?", "op": ["A) Não era", "B) Sepultamento respeitoso", "C) Era desprezada", "D) Ignorada"]},"r": "B"},{"dif": "Intermediária", "q": "O que silêncio representava?", "op": ["A) Derrota final", "B) Repouso antes de vitória", "C) Indiferença", "D) Sem significado"]},"r": "B"},{"dif": "Avançada", "q": "Por que sepultamento era crucial?", "op": ["A) Não era", "B) Eliminava especulação sobre corpo", "C) Era desnecessário", "D) Irrelevante"]},"r": "B"},{"dif": "Avançada", "q": "Como esperança germinava?", "op": ["A) Não germinava", "B) Morte genuína promete ressurreição", "C) Apenas desejo", "D) Ilusão"]},"r": "B"},{"dif": "Avançada", "q": "Qual era significado de 'novo'?", "op": ["A) Irrelevante", "B) Pureza de morte sem culpa", "C) Apenas detalhe", "D) Sem importância"]},"r": "B"},{"dif": "Avançada", "q": "Como aplicamos essa lição?", "op": ["A) Sem aplicação", "B) Esperança na morte de Cristo", "C) Apenas história", "D) Irrelevante"]},"r": "B"}], "vf": [{"q": "A morte de Cristo era aparente.","r": "F"},{"q": "Sepultamento confirmava morte genuína.","r": "V"},{"q": "Esperança morreu com Cristo.","r": "F"}]},
    {"id": "seg", "letra": "S", "data": "Segunda · 15 de setembro", "titulo": "Silêncio da Cruz", "keyideas": "Escuridão espiritual · Repouso divino · Suspensão de tempo · Espera criativa", "verses": ["Mateus 27:62-66", "João 19:38-42", "Hebreus 4:9-10"], "conteudo": "<b>\"Vendo a pedra removida, correu...\"</b> <b>Silêncio não era vazio, mas gravidez</b>. <b>Três dias em escuridão era não morte final, mas repouso antes de despertar</b>.\n\n<b>Guarda romana confirmava: ninguém podia escapar, ninguém podia intervir.</b> <b>Morte era definitiva, morte era completa, morte era segura</b>.\n\n<b>\"Há um repouso que permanece para o povo de Deus.\"</b> <b>Cristo em sepulcro era entrada em repouso divino</b> — <b>não inatividade, mas repouso criativo antes de ressurreição gloriosa</b>.", "reflexivas": ["Por que silêncio era significativo?", "Como repouso era criativo?", "Por que guarda importava?"], "quiz": [{"dif": "Fácil", "q": "Silêncio era vazio?", "op": ["A) Sim", "B) Não — repleto de significado", "C) Parcialmente", "D) Irrelevante"]},"r": "B"},{"dif": "Fácil", "q": "Havia guarda?", "op": ["A) Não", "B) Sim — romana", "C) Parcial", "D) Inefetiva"]},"r": "B"},{"dif": "Fácil", "q": "Repouso era?", "op": ["A) Inatividade", "B) Preparação criativa", "C) Morte permanente", "D) Sem significado"]},"r": "B"},{"dif": "Intermediária", "q": "Por que escuridão era necessária?", "op": ["A) Não era", "B) Contraste com luz da ressurreição", "C) Era cruel", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "O que guarda comprovava?", "op": ["A) Nada", "B) Impossibilidade de fuga", "C) Deslealdade", "D) Irrelevante"]},"r": "B"},{"dif": "Intermediária", "q": "Como repouso era divino?", "op": ["A) Não era", "B) Comunhão com Deus", "C) Meramente físico", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Por que três dias eram significativos?", "op": ["A) Sem razão", "B) Ressurreição no terceiro dia", "C) Apenas número", "D) Irrelevante"]},"r": "B"},{"dif": "Avançada", "q": "Como gravidez funcionava?", "op": ["A) Não funcionava", "B) Expectativa da transformação", "C) Era vazia", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Qual era poder do repouso?", "op": ["A) Nenhum", "B) Preparava para vitória", "C) Era fraqueza", "D) Irrelevante"]},"r": "B"},{"dif": "Avançada", "q": "Como aplicamos verdade?", "op": ["A) Sem aplicação", "B) Fé que espera no repouso", "C) Apenas história", "D) Irrelevante"]},"r": "B"}], "vf": [{"q": "Silêncio era vazio de significado.","r": "F"},{"q": "Repouso de Cristo era preparação para ressurreição.","r": "V"},{"q": "Ninguém podia escapar do sepulcro de Cristo.","r": "V"}]},
    {"id": "ter", "letra": "T", "data": "Terça · 16 de setembro", "titulo": "Fé Durante Trevas", "keyideas": "Discípulos perdidos · Escuridão da fé · Lembrança de promessa · Esperança invisível", "verses": ["Lucas 24:4-8", "João 20:9", "1 Pedro 1:3-4"], "conteudo": "<b>\"Onde puseram o Senhor?\"</b> <b>Maria não entendia — esperança havia morrido com Cristo</b>. <b>Três anos de ensinamento, milagres, comunhão — tudo parecia ter terminado em nada</b>.\n\n<b>Mas havia lembrança oculta.</b> <b>\"Ele disse que no terceiro dia ressuscitaria.\"</b> <b>Promessas não compreendidas quando ditas agora retornavam à memória</b>.\n\n<b>\"Abençoado seja o Deus...que nos regenerou...para uma esperança viva.\"</b> <b>Mesmo em escuridão, esperança não era morta — apenas silenciosa, invisível, germinal</b>. <b>Os discípulos ainda não a viam, mas ela estava ali</b>.", "reflexivas": ["Por que fé era obscura?", "Como promessa retornava?", "Por que esperança permanecia invisível?"], "quiz": [{"dif": "Fácil", "q": "Os discípulos entendiam?", "op": ["A) Sim", "B) Não — esperança havia morrido", "C) Parcialmente", "D) Completamente"]},"r": "B"},{"dif": "Fácil", "q": "Havia promessa?", "op": ["A) Não", "B) Sim — terceiro dia", "C) Esquecida", "D) Negada"]},"r": "B"},{"dif": "Fácil", "q": "Esperança era?", "op": ["A) Morta", "B) Viva mas invisível", "C) Indiferente", "D) Ausente"]},"r": "B"},{"dif": "Intermediária", "q": "Por que fé era trevas?", "op": ["A) Não era", "B) Verdade não era compreendida", "C) Não havia fé", "D) Era irracional"]},"r": "B"},{"dif": "Intermediária", "q": "Como lembrança retornava?", "op": ["A) Não retornava", "B) Espírito trazia à memória", "C) Apenas história", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "O que garantia esperança?", "op": ["A) Nada", "B) Promessa de Cristo", "C) Apenas desejo", "D) Ilusão"]},"r": "B"},{"dif": "Avançada", "q": "Por que invisibilidade importava?", "op": ["A) Não importava", "B) Testava fé genuína", "C) Era fraqueza", "D) Irrelevante"]},"r": "B"},{"dif": "Avançada", "q": "Como esperança germinal funcionava?", "op": ["A) Não funcionava", "B) Silenciosa mas real", "C) Apenas esperança", "D) Ilusória"]},"r": "B"},{"dif": "Avançada", "q": "Qual era o poder da lembrança?", "op": ["A) Nenhum", "B) Reconectava com promessa", "C) Era apenas nostalgia", "D) Irrelevante"]},"r": "B"},{"dif": "Avançada", "q": "Como aplicamos verdade?", "op": ["A) Sem aplicação", "B) Fé que espera promessa", "C) Apenas história", "D) Irrelevante"]},"r": "B"}], "vf": [{"q": "Os discípulos compreendiam a ressurreição.","r": "F"},{"q": "Esperança permanecia invisível durante o silêncio.","r": "V"},{"q": "Cristo não havia prometido ressurreição.","r": "F"}]},
    {"id": "qua", "letra": "Q", "data": "Quarta · 17 de setembro", "titulo": "Guarda da Pedra", "keyideas": "Testemunhas externas · Impossibilidade de fuga · Confirmação de morte · Preparação para milagre", "verses": ["Mateus 27:62-66", "Mateus 28:2-4", "Romanos 6:9"], "conteudo": "<b>\"Selaram a pedra e puseram guarda.\"</b> <b>Líderes religiosos, inadvertidamente, forneciam prova de ressurreição</b>. <b>Se body fosse removido, guarda o confirmaria</b>.\n\n<b>Nenhuma escape era possível.</b> <b>Pedra era selada, guarda era romana, morte era confirmada</b>. <b>Ressurreição, quando viesse, seria genuína, não fraude</b>.\n\n<b>\"Cristo, sendo ressuscitado, já não morre; a morte já não tem domínio sobre ele.\"</b> <b>Na impossibilidade de escape via corpo mortal, vitória seria absoluta</b> — <b>não de fuga, mas de ressurreição genuína</b>.", "reflexivas": ["Por que guarda importava?", "Como impossibilidade afirmava vitória?", "Por que testemunhas eram cruciais?"], "quiz": [{"dif": "Fácil", "q": "Por que havia guarda?", "op": ["A) Sem razão", "B) Líderes temiam ressurreição", "C) Honra de Cristo", "D) Proteção do corpo"]},"r": "B"},{"dif": "Fácil", "q": "Pedra era selada?", "op": ["A) Não", "B) Sim — oficialmente", "C) Parcialmente", "D) Temporariamente"]},"r": "B"},{"dif": "Fácil", "q": "Escape era possível?", "op": ["A) Sim", "B) Não — impossível", "C) Talvez", "D) Improvável"]},"r": "B"},{"dif": "Intermediária", "q": "Como guarda provia prova?", "op": ["A) Não provia", "B) Confirmaria remoção de body", "C) Era inútil", "D) Irrelevante"]},"r": "B"},{"dif": "Intermediária", "q": "Por que impossibilidade era boa?", "op": ["A) Não era", "B) Tornava ressurreição genuína", "C) Era obstáculo", "D) Irrelevante"]},"r": "B"},{"dif": "Intermediária", "q": "O que morte confirmada significava?", "op": ["A) Nada", "B) Ressurreição seria real", "C) Apenas morte", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Por que testemunhas eram cruciais?", "op": ["A) Não eram", "B) Eliminavam acusação de roubo", "C) Eram irrelevantes", "D) Atrapalhavam"]},"r": "B"},{"dif": "Avançada", "q": "Como guarda se tornava prova?", "op": ["A) Não se tornava", "B) Presença confirmava impossibilidade de roubo", "C) Era apenas obstáculo", "D) Irrelevante"]},"r": "B"},{"dif": "Avançada", "q": "Qual era o poder de selagem?", "op": ["A) Nenhum", "B) Confirmava que ressurreição era genuína", "C) Evitava ressurreição", "D) Irrelevante"]},"r": "B"},{"dif": "Avançada", "q": "Como aplicamos verdade?", "op": ["A) Sem aplicação", "B) Ressurreição é verificável", "C) Apenas história", "D) Irrelevante"]},"r": "B"}], "vf": [{"q": "A guarda romana foi colocada por simpatizantes de Cristo.","r": "F"},{"q": "Impossibilidade de escape provia prova da ressurreição.","r": "V"},{"q": "A morte de Cristo não era genuína.","r": "F"}]},
    {"id": "qui", "letra": "Q", "data": "Quinta · 18 de setembro", "titulo": "Espera Criativa", "keyideas": "Repouso germinante · Transformação silenciosa · Preparação celeste · Promessa mantida", "verses": ["1 Coríntios 15:20-22", "Colossenses 1:18", "Romanos 6:5"], "conteudo": "<b>\"Cristo, primícias dos que dormem.\"</b> <b>Morte não era fim, mas sono — e sono tinha despertar</b>. <b>Três dias de silêncio era transformação em nível que olhos humanos não podiam ver</b>.\n\n<b>Corpo ressurreto estava sendo preparado.</b> <b>Não restauração do que era, mas transformação em algo novo</b> — <b>corpo incorruptível, imortal, espiritual</b>. <b>Em escuridão, Deus realizava maior obra</b>.\n\n<b>\"Se somos plantados na semelhança de sua morte, seremos também na de sua ressurreição.\"</b> <b>O que Deus fazia em Cristo, oferecia para humanidade</b>. <b>Morte não terminava a história; era capítulo antes de vitória</b>.", "reflexivas": ["Como morte era sono?", "O que era transformado?", "Por que promessa era certa?"], "quiz": [{"dif": "Fácil", "q": "Morte era fim?", "op": ["A) Sim", "B) Não — sono com despertar", "C) Talvez", "D) Indiferente"]},"r": "B"},{"dif": "Fácil", "q": "O que era transformado?", "op": ["A) Nada", "B) Corpo em forma ressurreta", "C) Apenas espírito", "D) Meramente preservado"]},"r": "B"},{"dif": "Fácil", "q": "Era restauração?", "op": ["A) Sim", "B) Não — transformação", "C) Parcial", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "Por que transformação era silenciosa?", "op": ["A) Não era", "B) Divina, além de compreensão humana", "C) Era invisível", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "Como corpo tornava novo?", "op": ["A) Não tornava", "B) Incorruptível, imortal, espiritual", "C) Meramente restaurado", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "O que promessa garantia?", "op": ["A) Nada", "B) Semelhança de ressurreição para crentes", "C) Apenas para Cristo", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Por que dormência é metáfora?", "op": ["A) Não é", "B) Implicava despertar futuro", "C) Era apenas sono", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Como primícias funcionavam?", "op": ["A) Não funcionavam", "B) Cristo era primeiro de muitos", "C) Apenas uma", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Qual era significado de 'plantadas'?", "op": ["A) Enterradas", "B) Morte produz vida", "C) Sem vida", "d) "Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Como aplicamos verdade?", "op": ["A) Sem aplicação", "B) Esperança em transformação via Cristo", "C) Apenas história", "D) Irrelevante"]},"r": "B"}], "vf": [{"q": "Morte era final para Cristo.","r": "F"},{"q": "Transformação para novo corpo era preparada.","r": "V"},{"q": "Ressurreição era apenas para Cristo.","r": "F"}]},
    {"id": "sex", "letra": "S", "data": "Sexta · 19 de setembro", "titulo": "Fé nas Trevas", "keyideas": "Confiança invisible · Sustentação divina · Promessa mantida sempre · Fidelidade testada", "verses": ["Hebreus 11:1", "2 Coríntios 5:7", "1 Pedro 1:6-7"], "conteudo": "<b>\"Fé é a substância das coisas que se esperam.\"</b> <b>Discípulos não viam ressurreição — apenas acreditavam em promessa</b>. <b>Fé não era visão; era confiança em Palavra invisível</b>.\n\n<b>\"Andamos pela fé, não pela vista.\"</b> <b>Na escuridão do sepulcro, três dias pareciam eternidade</b>. <b>Mas fé mantinha: \"Ele prometeu; Ele cumprirá\"</b>.\n\n<b>\"Para que o resultado de vossa fé...seja achado em louvor e glória.\"</b> <b>Fé testada nas trevas produzia ouro genuíno</b>. <b>Verdadeira confiança em Deus não repousa em circunstâncias visíveis, mas em caráter invisível de Deus</b>.", "reflexivas": ["Como fé funcionava sem visão?", "Por que confiança era testada?", "Como promessa sustentava?"], "quiz": [{"dif": "Fácil", "q": "Discípulos viam ressurreição?", "op": ["A) Sim", "B) Não — acreditavam em promessa", "C) Parcialmente", "D) Meramente esperavam"]},"r": "B"},{"dif": "Fácil", "q": "Fé era visão?", "op": ["A) Sim", "B) Não — confiança invisível", "C) Parcial", "D) Indiferente"]},"r": "B"},{"dif": "Fácil", "q": "Andança era?", "op": ["A) Por visão", "B) Por fé", "C) Por sentimento", "D) Por lógica"]},"r": "B"},{"dif": "Intermediária", "q": "Por que três dias eram eternidade?", "op": ["A) Não eram", "B) Sem confirmação visual", "C) Meramente psicológico", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "O que sustentava?", "op": ["A) Nada", "B) Palavra de promessa", "C) Apenas esperança", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "Como fé era testada?", "op": ["A) Não era", "B) Nas circunstâncias adversas", "C) Não poderia ser", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Por que invisibilidade era importante?", "op": ["A) Não era", "B) Produzia fé genuína", "C) Era obstáculo", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Como ouro era produzido?", "op": ["A) Não era", "B) Fé refinou nas trevas", "C) Meramente metáfora", "d) "Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Qual era fundação da fé?", "op": ["A) Circunstâncias", "B) Caráter invisível de Deus", "C) Sentimento", "D) Lógica"]},"r": "B"},{"dif": "Avançada", "q": "Como aplicamos verdade?", "op": ["A) Sem aplicação", "B) Fé nas trevas sustenta até revelação", "C) Apenas história", "D) Irrelevante"]},"r": "B"}], "vf": [{"q": "Fé discipular era baseada em visão.","r": "F"},{"q": "Promessa de Cristo sustentava fé na escuridão.","r": "V"},{"q": "Fé testada nas trevas é fraca.","r": "F"}]},
    {"id": "sab", "letra": "S", "data": "Sábado · 20 de setembro · Comunidade", "titulo": "Esperança na Morte", "keyideas": "Morte não final · Repouso germinante · Fé invisível · Transformação preparada", "verses": ["Romanos 6:8-9", "1 Tessalonicenses 4:14", "1 Coríntios 15:55-57"], "conteudo": "<b>\"Se morremos com Ele, também viveremos com Ele.\"</b> <b>A semana havia mostrado que morte não era fim — era transição</b>. <b>Três dias de silêncio, fé invisível, promessa mantida</b>.\n\n<b>Corpo estava no sepulcro; esperança estava no coração.</b> <b>Fé que não descansava em circunstâncias visíveis, mas em caráter de Deus</b> — <b>isto era poder que nenhuma morte poderia extinguir</b>.\n\n<b>\"Morte, onde está a tua vitória?\"</b> <b>Na morte de Cristo, vida era plantada</b>. <b>Crentes poderiam confiar: o que Deus fez em Cristo, faria neles também</b>.", "reflexivas": ["Como morte tornava-se vida?", "Por que esperança era invisível?"], "quiz": [{"dif": "Fácil", "q": "Morte era final?", "op": ["A) Sim", "B) Não — transição", "C) Parcial", "D) Indiferente"]},"r": "B"},{"dif": "Fácil", "q": "Fé repousava em?", "op": ["A) Circunstâncias", "B) Caráter de Deus", "C) Sentimento", "D) Esperança"]},"r": "B"},{"dif": "Fácil", "q": "O que era plantado?", "op": ["A) Morte", "B) Vida", "C) Escuridão", "D) Nada"]},"r": "B"},{"dif": "Intermediária", "q": "Por que corpo e esperança se separavam?", "op": ["A) Não se separavam", "B) Morte corporal não extinguia esperança", "C) Ambos morriam", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "Como promessa permanecia?", "op": ["A) Não permanecia", "B) Independente de circunstância", "C) Era apenas sentimento", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "O que Deus faria neles?", "op": ["A) Nada", "B) O mesmo que em Cristo", "C) Apenas espiritualmente", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Por que esperança era poder?", "op": ["A) Não era", "B) Transcendia morte", "C) Era fraca", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Como morte perdia vitória?", "op": ["A) Não perdia", "B) Ressurreição provava derrota", "C) Tinha vitória total", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Qual era significado final?", "op": ["A) Nenhum", "B) Morte não é fim da história", "C) Indiferente", "D) Irrelevante"]},"r": "B"},{"dif": "Avançada", "q": "Como aplicamos lição?", "op": ["A) Sem aplicação", "B) Esperança na morte de Cristo sustenta eternamente", "C) Apenas história", "D) Irrelevante"]},"r": "B"}], "vf": [{"q": "Esperança morreu quando Cristo morreu.","r": "F"},{"q": "Morte de Cristo plantava vida para crentes.","r": "V"},{"q": "Fé invisível não é fé verdadeira.","r": "F"}]}
  ]
