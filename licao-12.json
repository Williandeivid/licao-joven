  "dias": [
    {"id": "dom", "letra": "D", "data": "Domingo · 21 de setembro", "titulo": "Madrugada da Esperança", "keyideas": "Ressurreição no terceiro dia · Pedra removida · Anjos testificam · Morte vencida", "verses": ["Mateus 28:1-7", "Marcos 16:1-8", "Lucas 24:1-8"], "conteudo": "<b>\"Ressuscitou!\"</b> <b>No terceiro dia, conforme prometido, morte era vencida</b>. <b>Não era ressuscitação de corpo adormecido, mas vitória sobre morte mesma</b>.\n\n<b>A pedra havia sido removida — não porque Cristo a precisava, mas porque vivos precisavam confirmação</b>. <b>Anjos testificavam: \"Ele não está aqui; ressuscitou\"</b>. <b>Testemunhas celestiais proclamavam o impossível tornando realidade</b>.\n\n<b>\"Como Deus o ressuscitou dentre os mortos.\"</b> <b>Não autossuscitação, mas ato divino de poder supremo</b>. <b>O mesmo poder que criou universo agora restaurava vida, vencia morte, estabelecia vitória eterna</b>.", "reflexivas": ["Por que ressurreição era necessária?", "Como morte era vencida?", "Por que testemunhas celestiais importavam?"], "quiz": [{"dif": "Fácil", "q": "Quando ressuscitava?", "op": ["A) Primeiro dia", "B) Terceiro dia", "C) Não ressuscitava", "D) Sétimo dia"]},"r": "B"},{"dif": "Fácil", "q": "Quem removeu pedra?", "op": ["A) Discípulos", "B) Anjos", "C) Jesus", "D) Ninguém"]},"r": "B"},{"dif": "Fácil", "q": "Ressurreição era?", "op": ["A) Alucinação", "B) Vitória sobre morte", "C) Ficção", "D) Engano"]},"r": "B"},{"dif": "Intermediária", "q": "Por que pedra era importante?", "op": ["A) Sem razão", "B) Confirmação de morte genuína", "C) Apenas detalhe", "D) Irrelevante"]},"r": "B"},{"dif": "Intermediária", "q": "Qual era o poder?", "op": ["A) Humano", "B) Divino — mesmo da criação", "C) Mágico", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "Qual era significado de 'terceiro dia'?", "op": ["A) Nenhum", "B) Ressurreição conforme promessa", "C) Apenas número", "D) Irrelevante"]},"r": "B"},{"dif": "Avançada", "q": "Por que ressurreição provava divindade?", "op": ["A) Não provava", "B) Somente Deus podia vencer morte", "C) Era coincidência", "D) Irrelevante"]},"r": "B"},{"dif": "Avançada", "q": "Como morte era vencida?", "op": ["A) Não era", "B) Ressurreição corporal genuína", "C) Meramente espiritual", "D) Sem vitória"]},"r": "B"},{"dif": "Avançada", "q": "Qual era implicação?", "op": ["A) Nenhuma", "B) Morte não era poder final", "C) Morte triunfava", "D) Irrelevante"]},"r": "B"},{"dif": "Avançada", "q": "Como aplicamos verdade?", "op": ["A) Sem aplicação", "B) Esperança na morte vencida", "C) Apenas história", "D) Irrelevante"]},"r": "B"}], "vf": [{"q": "Cristo ressuscitava no segundo dia.","r": "F"},{"q": "Ressurreição era vitória genuína sobre morte.","r": "V"},{"q": "Pedra não tinha significado.","r": "F"}]},
    {"id": "seg", "letra": "S", "data": "Segunda · 22 de setembro", "titulo": "Primeiras Aparições", "keyideas": "Testemunhas diversas · Reconhecimento e surpresa · Corporalidade verificável · Messagem identidade", "verses": ["Mateus 28:8-10", "João 20:11-18", "Marcos 16:9-11"], "conteudo": "<b>\"Maria, não me toque ainda.\"</b> <b>Jesus era realmente Ele — reconhecível, mas transformado</b>. <b>Corpo era novo, mas identidade era certa</b>.\n\n<b>Aparecia a Maria, depois às mulheres, depois a Pedro, depois a Tiago, depois aos 500</b> — <b>diversidade de testemunhas eliminava acusação de alucinação coletiva</b>. <b>Cada um reconhecia diferentemente, mas todos reconheciam</b>.\n\n<b>\"Ele viveu depois de sua morte.\"</b> <b>Ressurreição não era mera crença, mas realidade verificável</b>. <b>Múltiplas aparições, múltiplas locais, múltiplos dias — tudo confirmava: Ele voltou</b>.", "reflexivas": ["Por que aparições eram diversas?", "Como identidade era confirmada?", "Por que testemunhas múltiplas importavam?"], "quiz": [{"dif": "Fácil", "q": "Quem via primeiro?", "op": ["A) Discípulos", "B) Maria Madalena", "C) Pedro", "D) Todos simultaneamente"]},"r": "B"},{"dif": "Fácil", "q": "Corpo era?", "op": ["A) Fantasma", "B) Físico transformado", "C) Meramente espiritual", "D) Ilusão"]},"r": "B"},{"dif": "Fácil", "q": "Qual era a questão?", "op": ["A) Era verdadeiramente Ele?", "B) Como reconhecê-lo?", "C) Ambas", "D) Nenhuma"]},"r": "C"},{"dif": "Intermediária", "q": "Por que diversidade de testemunhas?", "op": ["A) Sem razão", "B) Eliminava acusação de alucinação", "C) Causava confusão", "D) Era desnecessária"]},"r": "B"},{"dif": "Intermediária", "q": "Como corpo era transformado?", "op": ["A) Não era", "B) Novo mas reconhecível", "C) Permanecia igual", "D) Era diferente demais"]},"r": "B"},{"dif": "Intermediária", "q": "O que 'não me toque' significava?", "op": ["A) Rejeição", "B) Transição de forma", "C) Apenas comando", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Por que múltiplas aparições eram cruciais?", "op": ["A) Não eram", "B) Estabeleciam realidade objetiva", "C) Eram desnecessárias", "D) Causavam dúvida"]},"r": "B"},{"dif": "Avançada", "q": "Como ressurreição era verificável?", "op": ["A) Não era", "B) Aparições físicas reais", "C) Apenas crença", "D) Alucinação"]},"r": "B"},{"dif": "Avançada", "q": "Qual era o poder das aparições?", "op": ["A) Nenhum", "B) Convertem ceticismo em fé", "C) Apenas drama", "D) Irrelevante"]},"r": "B"},{"dif": "Avançada", "q": "Como aplicamos verdade?", "op": ["A) Sem aplicação", "B) Ressurreição é evento histórico verificável", "C) Apenas mitologia", "D) Irrelevante"]},"r": "B"}], "vf": [{"q": "Testemunhas viam simultaneamente.","r": "F"},{"q": "Corpo ressurreto era reconhecível.","r": "V"},{"q": "Aparições eram apenas espirituais.","r": "F"}]},
    {"id": "ter", "letra": "T", "data": "Terça · 23 de setembro", "titulo": "Corpo Ressurreto", "keyideas": "Físico genuíno · Transformação completa · Incorruptível eterno · Primícias da redenção", "verses": ["1 Coríntios 15:42-49", "Filipenses 3:20-21", "1 João 3:2"], "conteudo": "<b>\"Semeia-se corpo animal; ressuscita corpo espiritual.\"</b> <b>Não abandono de corpo, mas transformação radicall</b>. <b>Corpo era real — comia peixe, podia ser tocado — mas era novo</b>.\n\n<b>Corpo ressurreto era incorruptível, imortal, glorificado</b> — <b>tudo que corpo terreno não podia ser</b>. <b>Jesus era primícias; os crentes seguiriam em padrão semelhante</b>.\n\n<b>\"Seremos semelhantes a Ele.\"</b> <b>Redenção não era escape de corpo, mas transformação de corpo</b>. <b>Ressurreição era restauração total da humanidade em sua forma glorificada</b>.", "reflexivas": ["Por que corpo era essencial?", "Como transformação funcionava?", "Por que primícias importavam?"], "quiz": [{"dif": "Fácil", "q": "Corpo era espiritual?", "op": ["A) Meramente", "B) Físico transformado", "C) Nenhum", "D) Fantasmagórico"]},"r": "B"},{"dif": "Fácil", "q": "Corpo era?", "op": ["A) Animal", "B) Espiritual transformado", "C) Ambos", "D) Indiferente"]},"r": "B"},{"dif": "Fácil", "q": "Qual era a propriedade?", "op": ["A) Corruptível", "B) Incorruptível e imortal", "C) Frágil", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "Por que transformação não era abandono?", "op": ["A) Era", "B) Corpo era renovado, não negado", "C) Meramente espiritual", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "Como corpo era verificado?", "op": ["A) Não era", "B) Comia, podia ser tocado", "C) Meramente visto", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "O que significava 'primícias'?", "op": ["A) Único", "B) Primeiro de muitos", "C) Sem paralelo", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Por que glorificação era necessária?", "op": ["A) Não era", "B) Perfecção exigia transformação", "C) Era opcional", "D) Irrelevante"]},"r": "B"},{"dif": "Avançada", "q": "Como crentes seriam semelhantes?", "op": ["A) Não seriam", "B) Ressurreição corporal glorificada", "C) Apenas espiritualmente", "D) Nunca"]},"r": "B"},{"dif": "Avançada", "q": "Qual era o significado total?", "op": ["A) Nenhum", "B) Redenção física total", "C) Apenas espiritual", "D) Parcial"]},"r": "B"},{"dif": "Avançada", "q": "Como aplicamos verdade?", "op": ["A) Sem aplicação", "B) Esperança em transformação corporal", "C) Apenas história", "D) Irrelevante"]},"r": "B"}], "vf": [{"q": "Corpo ressurreto era meramente espiritual.","r": "F"},{"q": "Corpo ressurreto era incorruptível e imortal.","r": "V"},{"q": "Crentes nunca seriam semelhantes a Cristo.","r": "F"}]},
    {"id": "qua", "letra": "Q", "data": "Quarta · 24 de setembro", "titulo": "Poder sobre Morte", "keyideas": "Vencedor supremo · Morte sem poder · Primeira de muitos · Dominion eterno", "verses": ["Romanos 6:9", "1 Coríntios 15:54-57", "Apocalipse 1:18"], "conteudo": "<b>\"Cristo, sendo ressuscitado, já não morre.\"</b> <b>Morte havia perdido seu poder</b>. <b>Não era vitória temporária, mas triunfo eterno</b>.\n\n<b>\"Eu sou o Vivo; fui morto, mas eis aqui estou vivo para sempre.\"</b> <b>Cristo não temia morte porque a havia conquistado</b>. <b>Nem grilhões da morte, nem poder do inferno, nem escuridão do sepulcro podia retê-lo</b>.\n\n<b>\"Morte, onde está tua vitória?\"</b> <b>A pergunta revelava verdade: morte era inimiga derrotada</b>. <b>Para crentes que criam em Cristo, morte não era fim, era transição para vida eterna</b>.", "reflexivas": ["Como morte era vencida?", "Por que poder era eterno?", "Como crentes eram afetados?"], "quiz": [{"dif": "Fácil", "q": "Cristo morreria de novo?", "op": ["A) Sim", "B) Não — já não morre", "C) Talvez", "D) Indiferente"]},"r": "B"},{"dif": "Fácil", "q": "Morte tinha poder?", "op": ["A) Sim", "B) Não — vencida", "C) Parcial", "D) Indiferente"]},"r": "B"},{"dif": "Fácil", "q": "Qual era a situação?", "op": ["A) Morte vitoriosa", "B) Morte derrotada", "C) Empate", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "Por que vitória era eterna?", "op": ["A) Não era", "B) Ressurreição era irrevogável", "C) Era temporária", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "O que significava 'para sempre vivo'?", "op": ["A) Apenas por tempo", "B) Eternidade sem morte", "C) Temporário", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "Como inferno era derrotado?", "op": ["A) Não era", "B) Cristo escapava, destruía poder", "C) Tinha poder", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Por que pergunta 'morte, onde' era crucial?", "op": ["A) Sem razão", "B) Morte não tinha resposta", "C) Morte triunfava", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Como crentes eram afetados?", "op": ["A) Não eram", "B) Vitória de Cristo garantia vida eterna", "C) Morreriam normalmente", "D) Irrelevante"]},"r": "B"},{"dif": "Avançada", "q": "Qual era o significado?", "op": ["A) Nenhum", "B) Morte não é mais inimiga final", "C) Morte é vitória", "D) Irrelevante"]},"r": "B"},{"dif": "Avançada", "q": "Como aplicamos verdade?", "op": ["A) Sem aplicação", "B) Confiança em vitória sobre morte", "C) Apenas história", "D) Irrelevante"]},"r": "B"}], "vf": [{"q": "Cristo morreria novamente.","r": "F"},{"q": "Morte foi completamente vencida.","r": "V"},{"q": "Morte permanecia como inimiga final.","r": "F"}]},
    {"id": "qui", "letra": "Q", "data": "Quinta · 25 de setembro", "titulo": "Comunhão Restaurada", "keyideas": "Relacionamento renovado · Refeições compartilhadas · Diálogos autênticos · Presença real", "verses": ["Lucas 24:30-43", "João 21:1-14", "1 Coríntios 15:5-7"], "conteudo": "<b>\"Partilhou do pão com eles.\"</b> <b>Ressurreição não era isolamento, era comunhão renovada</b>. <b>Jesus comia com discípulos, conversava normalmente, relacionava genuinamente</b>.\n\n<b>Na praia, Jesus preparava café da manhã para pescadores exaustos</b> — <b>serviço humilde de Jesus ressurreto</b>. <b>Morte não havia mudado Seu coração sacrificial; vitória não havia criado distância</b>.\n\n<b>\"Visto que o Senhor realmente ressuscitou.\"</b> <b>Presença real, comunhão verificável, relacionamento contínuo</b> — <b>tudo isto provia base para fé, não abstração teórica, mas realidade vivida</b>.", "reflexivas": ["Por que comunhão era importante?", "Como humanidade de Cristo permanecia?", "Por que refeições importavam?"], "quiz": [{"dif": "Fácil", "q": "Jesus comia?", "op": ["A) Não", "B) Sim — partilhava pão", "C) Apenas simbolicamente", "D) Indiferente"]},"r": "B"},{"dif": "Fácil", "q": "Cristo era?", "op": ["A) Distante", "B) Presente, comunhão real", "C) Meramente visível", "D) Indiferente"]},"r": "B"},{"dif": "Fácil", "q": "Qual era a ação?", "op": ["A) Julgamento", "B) Serviço e comunhão", "C) Afastamento", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "Por que refeições eram importantes?", "op": ["A) Sem razão", "B) Provavam corporalidade e comunhão", "C) Eram apenas necessidade", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "Qual era a natureza da comunhão?", "op": ["A) Apenas espiritual", "B) Física, audível, verificável", "C) Meramente teórica", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "Como presença era real?", "op": ["A) Não era", "B) Conversas, refeições, contato físico", "C) Apenas crença", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Por que serviço permanecia?", "op": ["A) Não permanecia", "B) Morte não havia mudado coração", "C) Tornava-se distante", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Como fé era baseada?", "op": ["A) Em teoria", "B) Em realidade vivida", "C) Em imaginação", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Qual era a implicação?", "op": ["A) Nenhuma", "B) Relacionamento com Cristo é real", "C) Apenas metáfora", "D) Irrelevante"]},"r": "B"},{"dif": "Avançada", "q": "Como aplicamos verdade?", "op": ["A) Sem aplicação", "B) Comunhão real com Cristo hoje", "C) Apenas passado", "D) Irrelevante"]},"r": "B"}], "vf": [{"q": "Jesus nunca comeu após ressurreição.","r": "F"},{"q": "Comunhão com Cristo era real e verificável.","r": "V"},{"q": "Morte havia mudado o coração sacrificial de Cristo.","r": "F"}]},
    {"id": "sex", "letra": "S", "data": "Sexta · 26 de setembro", "titulo": "Grande Comissão", "keyideas": "Autoridade conferida · Missão global · Espírito prometido · Transformação contínua", "verses": ["Mateus 28:18-20", "Marcos 16:15-18", "Atos 1:8"], "conteudo": "<b>\"Toda autoridade me foi dada no céu e na terra.\"</b> <b>Ressurreição não era apenas vitória pessoal, era coroação de autoridade cósmica</b>. <b>Cristo tinha domínio completo — não apenas espiritual, mas sobre toda realidade</b>.\n\n<b>\"Ide, ensinai todas as nações.\"</b> <b>Missão era globall, universal, sem limite temporal</b>. <b>Discípulos eram enviados com autoridade do Ressurreto, com Espírito do Ressurreto, para obra do Ressurreto</b>.\n\n<b>\"Recebereis poder quando o Espírito Santo descer.\"</b> <b>Poder não era humano — era divino, sustentador, transformador</b>. <b>Morte e ressurreição de Cristo estabelecia base; Espírito Santo executava missão contínua</b>.", "reflexivas": ["Como autoridade era dada?", "Por que missão era universal?", "Como Espírito capacitava?"], "quiz": [{"dif": "Fácil", "q": "Quem tinha autoridade?", "op": ["A) Discípulos", "B) Cristo ressurreto", "C) Ninguém", "D) Igreja"]},"r": "B"},{"dif": "Fácil", "q": "Qual era a extensão?", "op": ["A) Apenas Israel", "B) Todas as nações", "C) Europa", "D) Ninguém"]},"r": "B"},{"dif": "Fácil", "q": "Qual era o poder?", "op": ["A) Humano", "B) Divino (Espírito Santo)", "C) Político", "D) Nenhum"]},"r": "B"},{"dif": "Intermediária", "q": "Por que autoridade importava?", "op": ["A) Sem razão", "B) Legitimava missão", "C) Era simbólica", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "Como missão era contínua?", "op": ["A) Não era", "B) Espírito Santo persistia", "C) Apenas primeira geração", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "O que significava 'todas as nações'?", "op": ["A) Nenhuma limite", "B) Universalidade da salvação", "C) Apenas alguns", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Por que coroação era necessária?", "op": ["A) Não era", "B) Legitimava domínio cósmico", "C) Era desnecessária", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Como Espírito capacitava?", "op": ["A) Não capacitava", "B) Poder transformador para testemunho", "C) Meramente simbólico", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Qual era a base?", "op": ["A) Nenhuma", "B) Morte e ressurreição de Cristo", "C) Apenas promessa", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Como aplicamos verdade?", "op": ["A) Sem aplicação", "B) Participação na missão de Cristo", "C) Apenas passado", "D) Irrelevante"]},"r": "B"}], "vf": [{"q": "Autoridade era apenas espiritual.","r": "F"},{"q": "Missão de Cristo era universal.","r": "V"},{"q": "Espírito Santo capacitava a missão.","r": "V"}]},
    {"id": "sab", "letra": "S", "data": "Sábado · 27 de setembro · Comunidade", "titulo": "Vitória Definitiva", "keyideas": "Derrota aparente, vitória real · Morte vencida eternamente · Esperança confirmada · Novo início", "verses": ["1 Coríntios 15:57", "Apocalipse 1:17-18", "Romanos 6:8-9"], "conteudo": "<b>\"Morte, onde está tua vitória?\"</b> <b>A semana havia demonstrado realidade suprema: morte havia perdido eternamente</b>. <b>Não era promessa futura — era realidade presente em corpo ressurreto</b>.\n\n<b>Aparência de derrota na cruz se revelava máxima vitória</b>. <b>Três dias de silêncio precediam triunfo eterno</b>. <b>Tudo que Cristo havia ensinado, prometido, conquistado — tudo isto era validado na ressurreição</b>.\n\n<b>\"Graças a Deus, que nos dá a vitória.\"</b> <b>Crentes eram convidados a participar desta vitória</b>. <b>Não apenas espectadores, mas herdeiros, co-vencedores, destinados à glória semelhante</b>.", "reflexivas": ["Como derrota tornava-se vitória?", "Por que ressurreição encerrava tudo?"], "quiz": [{"dif": "Fácil", "q": "Morte era vencida?", "op": ["A) Não", "B) Sim — eternamente", "C) Parcialmente", "D) Indiferente"]},"r": "B"},{"dif": "Fácil", "q": "Qual era a realidade?", "op": ["A) Derrota", "B) Vitória confirmada", "C) Incerteza", "D) Indiferente"]},"r": "B"},{"dif": "Fácil", "q": "Crentes eram?", "op": ["A) Espectadores", "B) Participantes da vitória", "C) Separados", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "Por que cruz era aparência?", "op": ["A) Não era", "B) Realidade era vitória mais profunda", "C) Era realmente derrota", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "Como silêncio conduzia?", "op": ["A) Não conduzia", "B) Preparava para triunfo", "C) Era apenas morte", "D) Indiferente"]},"r": "B"},{"dif": "Intermediária", "q": "O que era validado?", "op": ["A) Nada", "B) Tudo: ensino, promessa, conquista", "C) Apenas parte", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Por que participação importava?", "op": ["A) Não importava", "B) Tornava vitória pessoal", "C) Era irrelevante", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Como herdeiros eram constituídos?", "op": ["A) Não eram", "B) Fé em Cristo ressurreto", "C) Apenas alguns", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Qual era a promessa final?", "op": ["A) Nenhuma", "B) Glória semelhante a Cristo", "C) Apenas preservação", "D) Indiferente"]},"r": "B"},{"dif": "Avançada", "q": "Como aplicamos tudo?", "op": ["A) Sem aplicação", "B) Celebração de vitória e esperança", "C) Apenas história", "D) Irrelevante"]},"r": "B"}], "vf": [{"q": "Morte permanecia como inimiga final.","r": "F"},{"q": "Ressurreição era vitória definitiva e eterna.","r": "V"},{"q": "Crentes não participavam da vitória.","r": "F"}]}
  ]
