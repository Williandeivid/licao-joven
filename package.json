  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Williandeivid/licao-joven/issues"
  },
  "homepage": "https://github.com/Williandeivid/licao-joven#readme",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2"
  }
}
